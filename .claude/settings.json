{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "companyAnnouncements": ["Welcome to Harbor tutorial"],
  "permissions": {
    "allow": [
      "Agent",
      "Artifact",
      "AskUserQuestion",
      "Bash",
      "BashOutput",
      "Edit",
      "EnterPlanMode",
      "EnterWorktree",
      "ExitPlanMode",
      "ExitWorktree",
      "Glob",
      "Grep",
      "KillShell",
      "ListMcpResourcesTool",
      "LSP",
      "Monitor",
      "NotebookEdit",
      "Read",
      "ReadMcpResourceTool",
      "ReportFindings",
      "ScheduleWakeup",
      "SendMessage",
      "Skill",
      "TaskCreate",
      "TaskGet",
      "TaskList",
      "TaskOutput",
      "TaskStop",
      "TaskUpdate",
      "TodoWrite",
      "ToolSearch",
      "WebFetch",
      "WebSearch",
      "Workflow",
      "Write",
      "mcp__playwright-harbor-tutor"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf ~/*)",
      "Bash(rm -rf $HOME*)",
      "Bash(sudo rm -rf *)",
      "Bash(*--no-preserve-root*)",
      "Bash(mkfs*)",
      "Bash(diskutil erase*)",
      "Bash(dd * of=/dev/*)",

      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git branch -D*)",
      "Bash(git filter-branch*)",

      "Read(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Edit(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.azure/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.npmrc)",
      "Read(~/.pypirc)",
      "Read(~/.netrc)",
      "Read(~/.bash_history)",
      "Read(~/.zsh_history)",
      "Read(~/.claude/.credentials.json)",
      "Edit(~/.claude/.credentials.json)",
      "Read(~/.zsh_secrets)",
      "Edit(~/.zsh_secrets)",
      "Read(~/.config/sops/age/**)",
      "Edit(~/.config/sops/age/**)",

      "Read(./secrets/**)",
      "Read(./.secrets/**)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/.env.staging)",
      "Read(./.npmrc)",
      "Read(./**/*credentials*.json)",
      "Read(./**/serviceAccountKey.json)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(./**/*.keystore)",
      "Read(./**/*.jks)",
      "Read(./**/*.agekey)",
      "Read(./**/keys.txt)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.backup)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__playwright-harbor-tutor__browser_(navigate|navigate_back|tab_new|snapshot|take_screenshot|run_code)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/playwright-post-navigate.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/playwright-cleanup.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "dev-tools-plugin@claude-my-marketplace": true,
    "plugin-dev@claude-plugins-official": true
  }
}
