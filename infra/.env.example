# Copy to .env before running `docker compose up -d`:
#   cp .env.example .env
#
# docker-compose.yaml supplies the defaults shown here, so the stack starts even
# without a .env file. You only need real values for the hosted providers.

# ── LiteLLM gateway ──────────────────────────────────────────────────────────
# Bearer token every client must send to the proxy. Lessons pass this into task
# containers as OPENAI_API_KEY.
LITELLM_MASTER_KEY=sk-litellm-master

# Host port the gateway binds to. Change it if something else already owns 4000
# (e.g. another LiteLLM stack on the same machine).
LITELLM_PORT=4000

# What Module 8's tasks use to reach the gateway from inside their container.
# If you changed LITELLM_PORT above, change the port here to match, and export
# this variable in the shell you run the lessons from.
LITELLM_BASE_URL=http://host.docker.internal:4000/v1

# Where the proxy finds LMStudio. LMStudio runs natively on the host (it needs
# GPU access), so the proxy container reaches it via the host gateway.
LM_STUDIO_API_BASE=http://host.containers.internal:1234/v1

# ── Optional hosted providers ────────────────────────────────────────────────
# Needed for the `gemma-large` alias (the default judge in Module 8) and its
# paid fallbacks. Free tier: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Needed for the `gpt-mini` alias — the last link in the judge fallback chain.
OPENAI_API_KEY=
